# Copie para .env e preencha os valores reais. Nunca commite o .env.

# Chave da API do Gemini (https://aistudio.google.com/apikey) - tier gratuito
# Ja tem fallback pro nome de modelo no codigo, mas o exposto abaixo e o default.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Padrao recomendado pelo Google para os modelos Gemini 3.x.
GEMINI_TEMPERATURE=1.0
GEMINI_TIMEOUT_SECONDS=60

# Provider usado na triagem dos achados. Hoje so "gemini" - a interface em
# app/services/ai_triage/base.py permite plugar outro depois.
AI_TRIAGE_PROVIDER=gemini

# Caminhos dos binarios externos (ajuste se nao estiverem no PATH)
SUBFINDER_PATH=subfinder
# ATENCAO - HTTPX_PATH: o pacote Python `httpx` (dependencia transitiva do
# google-genai) instala um script de linha de comando TAMBEM chamado
# `httpx` dentro do venv do uv, e esse script tem prioridade no PATH
# quando rodado via `uv run`. Isso faz o valor "httpx" aqui apontar pro
# pacote Python errado, nao pro binario da ProjectDiscovery - confirmado
# na pratica (erro "httpx terminou com codigo 1", mensagem pedindo
# `pip install httpx[cli]`). Troque pelo caminho ABSOLUTO do binario real:
#   which httpx   # ANTES de rodar `uv sync`/`uv run`, pra nao pegar o do venv
HTTPX_PATH=httpx
NMAP_PATH=nmap
GITLEAKS_PATH=gitleaks

# Timeout (segundos) para cada ferramenta externa por etapa do scan
TOOL_TIMEOUT_SECONDS=300

# Origens permitidas para CORS (frontend local)
CORS_ORIGINS=["http://localhost:3000"]
