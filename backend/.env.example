# Copie para .env e preencha os valores reais. Nunca commite o .env.

# Chave da API do Gemini (https://aistudio.google.com/apikey) - tier gratuito
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Caminhos dos binarios externos (ajuste se nao estiverem no PATH)
SUBFINDER_PATH=subfinder
HTTPX_PATH=httpx
NMAP_PATH=nmap
GITLEAKS_PATH=gitleaks

# Timeout (segundos) para cada ferramenta externa por etapa do scan
TOOL_TIMEOUT_SECONDS=300

# Origens permitidas para CORS (frontend local)
CORS_ORIGINS=["http://localhost:3000"]
